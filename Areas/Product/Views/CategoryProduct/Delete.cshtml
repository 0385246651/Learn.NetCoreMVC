@model App.Models.Product.CategoryProduct
@using App.Menu
@inject AdminSidebarService _AdminSidebarService

@{
  ViewData["Title"] = "Xóa chuyên mục Sản phẩm";
  Layout = "/Views/Shared/_LayoutAdmin.cshtml";
}


<h3>Có chắc chắn xóa?</h3>
<div>

  <dl class="row">
    <dt class="col-sm-4">
      @Html.DisplayNameFor(model => model.Title)
    </dt>
    <dd class="col-sm-8">
      @Html.DisplayFor(model => model.Title)
    </dd>
  </dl>

  <form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Xóa" class="btn btn-danger" /> |
    <a asp-action="Index">Danh sách chuyên mục Sản phẩm</a>
  </form>
</div>

@{
  _AdminSidebarService.SetActive("Contact", "Index", "Contact");
}

@section Sidebar
{
  @Html.Raw(_AdminSidebarService.renderHtml())
}