@model EditClaimModel
@{
    ViewData["Title"] = "Gán đặc tính cho role";
}

<div class="card shadow-sm">
    <div class="card-header">
        <h4 class="mb-0">
            <i class="fa-solid fa-user-shield"></i> @ViewData["Title"]: <span
                class="text-primary">@Model.role.Name</span>
        </h4>
    </div>

    <div class="card-body">
        <partial name="_StatusMessage" />

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="ClaimType" class="form-label fw-bold">
                    <i class="fa-solid fa-tag"></i> @Html.DisplayNameFor(m => m.ClaimType)
                </label>
                <input asp-for="ClaimType" class="form-control" />
                <span asp-validation-for="ClaimType" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ClaimValue" class="form-label fw-bold">
                    <i class="fa-solid fa-key"></i> @Html.DisplayNameFor(m => m.ClaimValue)
                </label>
                <input asp-for="ClaimValue" class="form-control" />
                <span asp-validation-for="ClaimValue" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="fa-solid fa-plus"></i> Tạo mới
                </button>
                <a class="btn btn-primary" asp-action="Edit" asp-route-roleid="@Model.role.Id">
                    <i class="fa-solid fa-pen-to-square"></i> Sửa role
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
