@model EditRoleModel

@{
    ViewData["Title"] = "Cập nhật role";
}
<h2>@ViewData["Title"]</h2>
<partial name="_StatusMessage"></partial>

<hr>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i> Cập nhật
                </button>
                <a class="btn btn-secondary" asp-action="Index">
                    <i class="fas fa-list me-1"></i> Danh sách các role
                </a>
            </div>
        </form>

        <hr>

        <p class="fw-bold">
            Các đặc tính (claim) của role:
            <a asp-action="AddRoleClaim" asp-route-roleid="@Model.role.Id" class="btn btn-sm btn-success ms-2">
                <i class="fas fa-plus me-1"></i> Thêm claim
            </a>
        </p>

        @if (Model.Claims.Count > 0)
        {
            <ul class="list-group">
                @foreach (var claim in Model.Claims)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>
                            <i class="fas fa-key me-1 text-muted"></i>
                            <strong>@claim.ClaimType</strong> : @claim.ClaimValue
                        </span>
                        <a asp-action="EditRoleClaim" asp-route-claimid="@claim.Id" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-edit me-1"></i> Sửa
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
