@model List<RoleModel>
@{
    ViewData["Title"] = "Danh sách các role (vai trò)";
}
<h2>@ViewData["Title"]</h2>

<partial name="_StatusMessage"></partial>

<div class="mb-3">
    <a class="btn btn-primary me-2" asp-action="Create">
        <i class="fas fa-plus me-1"></i> Tạo role mới
    </a>
    <a class="btn btn-secondary" asp-action="Index" asp-controller="User">
        <i class="fas fa-users me-1"></i> Quản lý thành viên
    </a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Tên Role (vai trò)</th>
            <th style="width: 220px;">Tác vụ</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>
                    <strong>@role.Name</strong>
                    @if (role.Claims != null && role.Claims.Any())
                    {
                        <div class="mt-1">
                            @foreach (var claim in role.Claims)
                            {
                                <small class="text-muted d-block">
                                    <i class="fas fa-key me-1"></i> @claim
                                </small>
                            }
                        </div>
                    }
                </td>
                <td>
                    <div class="d-flex gap-2">
                        <a class="btn btn-success btn-sm" asp-action="Edit" asp-route-roleid="@role.Id">
                            <i class="fas fa-edit me-1"></i> Cập nhật
                        </a>
                        <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-roleid="@role.Id">
                            <i class="fas fa-trash-alt me-1"></i> Xóa
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
