@{
    ViewData["Title"] = "Thông báo lấy lại mật khẩu";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg rounded-3 border-0">
                <div class="card-body text-center">
                    <h2 class="card-title text-success mb-3">
                        <i class="fas fa-check-circle"></i> @ViewData["Title"]
                    </h2>
                    <p class="lead text-muted">
                        Vui lòng kiểm tra email để hoàn tất việc đặt lại mật khẩu.
                    </p>
                    <a href="~/Account/Login" class="btn btn-primary mt-3">
                        <i class="fas fa-sign-in-alt"></i> Quay lại đăng nhập
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
