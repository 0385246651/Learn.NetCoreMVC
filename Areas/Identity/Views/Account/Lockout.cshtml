@{
    ViewData["Title"] = "Tạm khóa tài khoản";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg rounded-3 border-0">
                <div class="card-body text-center">
                    <h2 class="text-danger mb-3">
                        <i class="fas fa-user-lock"></i> @ViewData["Title"]
                    </h2>
                    <p class="lead text-muted">
                        Tài khoản của bạn đã bị tạm khóa.
                        Vui lòng thử lại sau hoặc liên hệ quản trị viên để được hỗ trợ.
                    </p>
                    <a href="~/Account/Login" class="btn btn-primary mt-3">
                        <i class="fas fa-sign-in-alt"></i> Quay lại đăng nhập
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
