@model SendCodeViewModel
@{
    ViewData["Title"] = "Gửi mã xác thực";
}

<h1>@ViewData["Title"]</h1>

<form asp-controller="Account" asp-action="SendCode" asp-route-returnurl="@Model.ReturnUrl" method="post"
    class="form-horizontal" role="form">

    <input asp-for="RememberMe" type="hidden" />

    <div class="form-group row">
        <label class="col-md-3 col-form-label">Mã xác thực gửi tới:</label>
        <div class="col-md-6">
            <select asp-for="SelectedProvider" asp-items="Model.Providers" class="form-control"></select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-success">
                <i class="fa fa-paper-plane"></i> Gửi
            </button>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
