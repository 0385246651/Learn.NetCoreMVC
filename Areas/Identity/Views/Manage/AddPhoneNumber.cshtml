@model AddPhoneNumberViewModel
@{
    ViewData["Title"] = "Thêm số điện thoại";
}

<h1>@ViewData["Title"]</h1>

<form asp-controller="Manage" asp-action="AddPhoneNumber" method="post" role="form">

    <h4>Thêm số điện thoại.</h4>
    <hr />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="fa fa-paper-plane"></i> Gửi mã
    </button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
