@model SetPasswordViewModel
@{
    ViewData["Title"] = "Đặt mật khẩu";
}

<div class="alert alert-info d-flex align-items-center" role="alert">
    <i class="fa-solid fa-circle-info me-2"></i>
    <div>
        Tài khoản của bạn chưa có mật khẩu, hãy thiết lập để có thể
        đăng nhập mà không cần dùng tài khoản ngoài.
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header">
        <h4 class="mb-0"><i class="fa-solid fa-key"></i> Đặt mật khẩu</h4>
    </div>
    <div class="card-body">
        <form asp-controller="Manage" asp-action="SetPassword" asp-route-returnurl="@ViewData["ReturnUrl"]"
            method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">
                    <i class="fa-solid fa-lock"></i> @Html.DisplayNameFor(m => m.NewPassword)
                </label>
                <input asp-for="NewPassword" class="form-control" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">
                    <i class="fa-solid fa-lock"></i> @Html.DisplayNameFor(m => m.ConfirmPassword)
                </label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk"></i> Đặt mật khẩu
            </button>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
