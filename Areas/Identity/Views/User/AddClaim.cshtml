@model AddUserClaimModel
@{
    ViewData["Title"] = "Claim của user";
}
<h1>@ViewData["Title"] : @ViewBag.user.UserName</h1>
<partial name="_StatusMessage" />

<hr>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="ClaimType" class="form-label"></label>
                <input asp-for="ClaimType" class="form-control" />
                <span asp-validation-for="ClaimType" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ClaimValue" class="form-label"></label>
                <input asp-for="ClaimValue" class="form-control" />
                <span asp-validation-for="ClaimValue" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                @if (ViewBag.userclaim != null)
                {
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-edit me-1"></i> Cập nhật
                    </button>
                    <button type="submit" asp-action="DeleteClaim" asp-route-claimid="@ViewBag.userclaim.Id"
                        class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i> Xóa
                    </button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i> Tạo mới
                    </button>
                }

                <a class="btn btn-secondary" asp-action="AddRole" asp-route-id="@ViewBag.user.Id">
                    <i class="fas fa-user-shield me-1"></i> Edit User Role
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
