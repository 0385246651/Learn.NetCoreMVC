@model SetUserPasswordModel
@{
    ViewData["Title"] = "Đặt mật khẩu";
}

<h4>
    <i class="fas fa-key me-1"></i> Thiết lập mật khẩu cho thành viên: @ViewBag.user.UserName
</h4>
<partial name="_StatusMessage" />

<div class="row">
    <div class="col-md-6">
        <form id="set-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success me-2">
                <i class="fas fa-save me-1"></i> Đặt mật khẩu
            </button>
            <a class="btn btn-secondary" asp-action="Index">
                <i class="fas fa-arrow-left me-1"></i> Danh sách thành viên
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
